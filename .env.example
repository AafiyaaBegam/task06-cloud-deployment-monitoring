# Copy to .env on the server. Never commit the populated .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Set a real HTTPS incident webhook URL to receive Prometheus alerts.
ALERT_WEBHOOK_URL=https://YOUR-INCIDENT-WEBHOOK-ENDPOINT

# Local PostgreSQL password; use a unique strong value.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
